# Copy to .env to make Foreman actually send its notification emails.
# Without a .env, emails are only saved to outbox/ (nothing is sent).

# Local Mailpit (catches everything, sends nothing outside your machine):
#   docker run -d --name foreman-mailpit -p 127.0.0.1:1025:1025 -p 127.0.0.1:8026:8025 axllent/mailpit
#   inbox: http://127.0.0.1:8026
FOREMAN_SMTP_HOST=127.0.0.1
FOREMAN_SMTP_PORT=1025

# A real mail server instead (keep real credentials out of git; .env is ignored):
# FOREMAN_SMTP_HOST=smtp.example.com
# FOREMAN_SMTP_PORT=587
# FOREMAN_SMTP_TLS=1
# FOREMAN_SMTP_USER=foreman@example.com
# FOREMAN_SMTP_PASSWORD=

# FOREMAN_MAIL_FROM="Foreman <foreman@invoicely.example>"
